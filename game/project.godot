; Engine configuration file.
; Edited by hand and by the Godot editor. Keep it in text form.

config_version=5

[application]

config/name="GrimDark"
config/description="45-player co-op PvE traitor Guard shooter (fan project)."
run/main_scene="res://scenes/test_range/test_range.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/core/game_data.gd"
Controls="*res://scripts/core/controls.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"

# Normalise text files
* text=auto eol=lf

# Godot text formats
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf

# Binary art and audio are stored directly in git (no Git LFS), so ZIP downloads and plain clones work.
*.png binary
*.jpg binary
*.exr binary
*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.dds binary
*.tga binary
*.ply binary

# GEM engine source files: text formats
*.mdl text eol=lf
*.mtl text eol=lf
*.def text eol=lf
